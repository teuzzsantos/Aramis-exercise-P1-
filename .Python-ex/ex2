numeros = []

for i in range(1, 4):
    while True:
        try:
            numero = int(input(f"Digite o {i}º número inteiro: "))
            numeros.append(numero)
            break
        except ValueError:
            print("Valor inválido. Digite um número inteiro.")

soma = sum(numeros)

print(f"A soma dos três números é: {soma}")
